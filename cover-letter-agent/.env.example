# Copy this file to .env and fill in your key. .env is gitignored.

# Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for every pipeline step.
ANTHROPIC_MODEL=claude-opus-5-5

# Job search (Phase 3): free keys from https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: use the app on more than one computer. A folder that syncs between them (for
# example in OneDrive) for your applications, letters, answers and exports. Leave blank to
# keep everything in this folder. Restart the app after changing it. See README.md.
#   Windows: SYNC_FOLDER=C:\Users\you\OneDrive\JobAgents
#   Mac:     SYNC_FOLDER=~/Library/CloudStorage/OneDrive-Personal/JobAgents
SYNC_FOLDER=
